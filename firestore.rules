rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin whitelist check
    // NOTE: kept in sync with ADMIN_EMAILS in app/src/lib/auth-context.tsx
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in ['shane@nsccr.ca'];
    }

    // Public read for website content (gallery, services, etc.)
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contractors/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /partners/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // CRM (PRIVATE) — admin read AND write only
    // Impak / SD44 work-order data. NEVER publicly readable.
    // ============================================================
    match /tickets/{document=**} {
      allow read, write: if isAdmin();
    }
    match /projects/{document=**} {
      allow read, write: if isAdmin();
    }
    // Billing lane: supplier invoices / POs / statements (NOT tickets)
    match /documents/{document=**} {
      allow read, write: if isAdmin();
    }

    // Error logs (anyone can write for debugging, admin reads)
    match /error_logs/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Settings (admin whitelist, etc.)
    match /settings/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
