{
  "name": "fenestration-pro",
  "private": true,
  "version": "1.1.0",
  "description": "Window & glass configurator and IGU supplier quote tool",
  "author": "Western Windows Inc. <info@westernwindows.ca>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm run vite\" \"npm run electron:wait\"",
    "vite": "vite",
    "electron:wait": "wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .",
    "build": "tsc && vite build",
    "electron:build": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis portable"
  },
  "build": {
    "appId": "ca.westernwindows.app",
    "productName": "Western Windows",
    "copyright": "Copyright © 2025 Western Windows Inc.",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/ww1.png",
      "public/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "portable": {
      "artifactName": "Western Windows ${version} Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Western Windows",
      "uninstallDisplayName": "Western Windows"
    }
  },
  "dependencies": {
    "firebase": "^11.6.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.435.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0-beta.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "png-to-ico": "^3.0.1",
    "tailwindcss": "^4.0.0-beta.8",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "wait-on": "^8.0.0"
  }
}
